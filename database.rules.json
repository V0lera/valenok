{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[0-9]{4}$/)",
        "joins": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists()"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists()"
          }
        },
        "actions": {
          "$aid": {
            ".write": "auth != null && data.parent().parent().exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.parent().parent().child('host').val() === auth.uid)"
          }
        }
      }
    },
    "hands": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)"
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friends": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$fid": {
          ".write": "auth != null && (auth.uid === $owner || (auth.uid === $fid && (!newData.exists() || root.child('requests').child($fid).child($owner).exists())))"
        }
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || (auth.uid === $from && (!newData.exists() || root.child('friends').child($to).child($from).exists())))"
        }
      }
    }
  }
}
